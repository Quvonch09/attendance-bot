# Telegram BotFather'dan olinadigan tokenni .env ichiga qo‘ying; bu faylni ulashmang.
BOT_TOKEN=

# Admin Telegram ID raqamlari
ADMIN_IDS=8048583227,1922170479
CONTROLLER_IDS=8048583227

# Web App URL/API. API default bo‘yicha faqat loopback-da ishlaydi va o‘chiq.
WEBAPP_URL=
WEBAPP_ORIGIN=
WEBAPP_API_ENABLED=0
WEBAPP_API_HOST=127.0.0.1
WEBAPP_API_PORT=8765

# Innova maktabi joylashuv belgisi va geofence
OFFICE_LAT=38.8557873
OFFICE_LON=65.8002788
GEOFENCE_METERS=300
TIMEZONE=Asia/Tashkent

# Maxfiy davomat bazasi va selfilar saqlanadigan katalog
DATA_DIR=./data
